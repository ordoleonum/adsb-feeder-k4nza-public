#!/bin/bash
# do an OS update - either using the DietPi update tool or by just using apt

# log to /run/adsb-feeder-image.log
exec &>> /run/adsb-feeder-image.log

# K4NZA: tells the Updates page an OS update is running, also when it runs from
# the nightly update check (which isn't the adsb-feeder-update-os unit)
echo $$ > /run/k4nza-os-update.running
trap 'rm -f /run/k4nza-os-update.running' EXIT

if [ -x /boot/dietpi/dietpi-update ] ; then
    G_INTERACTIVE=0 CONFIG_CHECK_APT_UPDATES=2 /boot/dietpi/dietpi-update 1
else
    export DEBIAN_FRONTEND=noninteractive
    export APT_LISTCHANGES_FRONTEND=none
    apt-get update
    # upgrade with --with-new-pkgs: also installs the new packages an update
    # needs, which is how Raspberry Pi kernel updates arrive (a plain upgrade
    # holds them back forever). Nothing is ever removed by the upgrade itself.
    if ! apt-get -y -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef --with-new-pkgs upgrade; then
        dpkg --configure -a --force-confold --force-confdef
    fi
    # remove kernels and other packages nothing needs any more (apt always keeps
    # the running kernel and the newest one)
    apt-get -y autoremove
    # the downloaded packages are installed now; don't keep them on the SD card
    apt-get clean
fi

# restart important services if not running for some reason
# dietpi-update will stop adsb-setup / adsb-docker (dietpi services?!)
# it should start it back up but let's just be safe here
# (start, not restart: a no-op while it is running or starting)
if ! systemctl is-active --quiet adsb-setup.service; then
    systemctl start adsb-setup.service
fi
if ! systemctl is-active adsb-docker.service; then
    systemctl restart adsb-docker.service
fi
